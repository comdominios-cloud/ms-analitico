# ---- Aplicacion ----
APP_NAME=ms-analitico
# Puerto DENTRO del contenedor
APP_PORT=8005
# Puerto publicado en la VM de produccion (rango asignado por el curso: 9000-12000)
PUBLISHED_PORT=9005
APP_ENV=development
LOG_LEVEL=info

# ---- AWS (NUNCA poner credenciales reales en el repo) ----
# En EC2 lo correcto es usar un IAM Role, no llaves estaticas.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# ---- AWS Glue ----
GLUE_DATABASE=condominio_db
GLUE_CATALOG_ID=

# ---- AWS Athena ----
ATHENA_WORKGROUP=primary
# Bucket donde Athena deja los resultados de las consultas
ATHENA_OUTPUT_S3=s3://BUCKET-DEL-PROYECTO/athena-results/
# Bucket donde ingesta-datos deja los CSV/JSON crudos
DATA_LAKE_S3=s3://BUCKET-DEL-PROYECTO/raw/

# Tiempo maximo de espera por una consulta (segundos)
ATHENA_QUERY_TIMEOUT=60
